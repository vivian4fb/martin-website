---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, figures, sitters, url } from '../config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { title, description = site.description, image = url('/media/img/og.jpg') } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — Holography`;
// Canonical always points at the production domain, without any preview base path.
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname.slice(basePath.length) || '/', site.url).href;
// Preview builds (GitHub Pages) must not be indexed against Martin's live site.
const noindex = import.meta.env.PUBLIC_NOINDEX === '1';

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  image: new URL('/media/img/portrait-1200.jpg', site.url).href,
  jobTitle: 'Emeritus Professor of Holography',
  birthDate: '1958',
  birthPlace: 'London, United Kingdom',
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Royal College of Art' },
  award: 'Royal Photographic Society Saxby Medal (2009)',
  email: `mailto:${site.email}`,
  knowsAbout: ['Holography', 'Holographic portraiture', 'Optical imaging'],
  description: `${figures[0].value} ${figures[0].label}. Sitters include ${sitters.join(', ')}.`,
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#0a0a0c" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site).href} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Inter:wght@300;400;500&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <!-- Holographic diffraction background, from the banner on martin-richardson.com. -->
    <div class="bg-stage" aria-hidden="true">
      <div class="bg-depth">
        <div class="bg-float">
          <video
            class="bg-video"
            muted
            loop
            playsinline
            autoplay
            preload="none"
            disablepictureinpicture
            disableremoteplayback
            tabindex="-1"
            poster={url('/media/poster/bg-holo.jpg')}
            data-src-hd={url('/media/video/bg-holo-720.mp4')}
            data-src-sd={url('/media/video/bg-holo-480.mp4')}
          ></video>
        </div>
      </div>
      <div class="bg-scrim"></div>
    </div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Reveal-on-scroll and hover-preview for motion works.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }),
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => (reduce ? el.classList.add('in') : io.observe(el)));

      document.querySelectorAll<HTMLElement>('.card').forEach((card) => {
        card.addEventListener('pointermove', (ev) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${((ev.clientX - r.left) / r.width) * 100}%`);
          card.style.setProperty('--my', `${((ev.clientY - r.top) / r.height) * 100}%`);
        });
        const v = card.querySelector('video');
        // Touch screens have no hover: a tap opens the lightbox instead.
        if (!v || reduce || !finePointer) return;
        card.addEventListener('pointerenter', () => { v.play().catch(() => {}); });
        card.addEventListener('pointerleave', () => { v.pause(); v.currentTime = 0; });
      });

      // ── Holographic background ──
      // 480p on phones, 720p on wider screens. Reduced motion or Data Saver keeps the still poster.
      const bg = document.querySelector<HTMLVideoElement>('.bg-video');
      const depth = document.querySelector<HTMLElement>('.bg-depth');
      const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
      if (bg && !reduce && !saveData) {
        bg.muted = true;
        bg.defaultMuted = true;
        bg.src = (innerWidth >= 900 ? bg.dataset.srcHd : bg.dataset.srcSd) ?? '';
        const play = () => { if (!document.hidden) bg.play().catch(() => {}); };
        play();
        // iOS Low Power Mode and some Android browsers block autoplay until the first touch.
        addEventListener('touchstart', play, { once: true, passive: true });
        addEventListener('pointerdown', play, { once: true });
        document.addEventListener('visibilitychange', () => (document.hidden ? bg.pause() : play()));
        // Nothing to see behind the lightbox, so save the battery while it is open.
        const lb = document.querySelector('dialog.lightbox') as HTMLDialogElement | null;
        if (lb) new MutationObserver(() => (lb.open ? bg.pause() : play())).observe(lb, { attributes: true, attributeFilter: ['open'] });
      }

      // ── Depth on scroll ──
      // The background recedes as you scroll; content blocks float at slightly different depths.
      if (!reduce && depth && CSS.supports('translate', '0 1px')) {
        // Gallery cards float one by one. Bordered lists (figures, publications, timeline) float as a
        // whole block, or their dividers would drift out of line.
        const floaters = [
          ...document.querySelectorAll<HTMLElement>('main > section > .wrap > *, main > .wrap > *, main > .page-head > *'),
          ...document.querySelectorAll<HTMLElement>('.works > .card'),
        ].filter((el) => !el.matches('.works') && !el.closest('dialog'));
        const rates = [0.05, 0.1, 0.075];
        const rate = new WeakMap<HTMLElement, number>();
        const shift = new WeakMap<HTMLElement, number>();
        const onScreen = new Set<HTMLElement>();
        const io2 = new IntersectionObserver(
          (entries) => entries.forEach((e) => (e.isIntersecting ? onScreen.add(e.target as HTMLElement) : onScreen.delete(e.target as HTMLElement))),
          { rootMargin: '25% 0px' },
        );
        floaters.forEach((el) => {
          el.classList.add('float');
          rate.set(el, rates[[...el.parentElement!.children].indexOf(el) % rates.length]);
          io2.observe(el);
        });

        let queued = false;
        const update = () => {
          queued = false;
          const vh = innerHeight;
          const k = innerWidth < 820 ? 0.5 : 1;
          onScreen.forEach((el) => {
            const r = el.getBoundingClientRect();
            const offset = r.top - (shift.get(el) ?? 0) + r.height / 2 - vh / 2; // untransformed centre vs viewport centre
            const y = Math.max(-48, Math.min(48, -offset * rate.get(el)! * k));
            shift.set(el, y);
            el.style.translate = `0 ${y.toFixed(1)}px`;
          });
          const max = document.documentElement.scrollHeight - vh;
          depth.style.setProperty('--p', (max > 0 ? Math.min(1, scrollY / max) : 0).toFixed(4));
        };
        const queue = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
        addEventListener('scroll', queue, { passive: true });
        addEventListener('resize', queue);
        update();

        if (finePointer) {
          addEventListener('pointermove', (e) => {
            depth.style.setProperty('--tilt-x', `${((e.clientY / innerHeight) - 0.5) * -3}deg`);
            depth.style.setProperty('--tilt-y', `${((e.clientX / innerWidth) - 0.5) * 3}deg`);
          }, { passive: true });
        }
      }
    </script>
  </body>
</html>
