---
// Opening titles: an MR monogram, cut in the site serif, that splits down the seam between the two
// letters to reveal the site. Rendered by Base.astro directly inside <body> — inside <main> it
// would be trapped under the header's stacking context.
//
// The curtain is painted by CSS from the first frame, so the page never flashes before it. What
// removes it: this script, a <noscript> rule, and an inline check in Base.astro's <head> that adds
// .intro-skip before paint when the visitor has already seen it or asked for less motion.
//
// Each half holds its own copy of the monogram, one clipped left of the seam, one right, so the
// two read as a single mark until they part.
---

<div class="intro" aria-hidden="true" role="presentation">
  <div class="intro-half intro-left">
    <div class="intro-mark">
      <span class="intro-mr" data-text="MR">MR</span>
      <span class="intro-rule"></span>
      <span class="intro-name">Martin Richardson</span>
    </div>
  </div>
  <div class="intro-half intro-right">
    <div class="intro-mark">
      <span class="intro-mr" data-text="MR">MR</span>
      <span class="intro-rule"></span>
      <span class="intro-name">Martin Richardson</span>
    </div>
  </div>
  <span class="intro-seam"></span>
</div>

<noscript><style>.intro { display: none !important; }</style></noscript>

<style>
  .intro { position: fixed; inset: 0; z-index: 300; overflow: hidden; }
  :global(html.intro-skip) .intro { display: none; }

  /* Two doors. */
  .intro-half {
    position: absolute; top: 0; bottom: 0; width: 50.2%; overflow: hidden;
    background: radial-gradient(130% 110% at 50% 45%, #111116 0%, #08080a 62%, #050506 100%);
    transition: transform 820ms cubic-bezier(0.76, 0, 0.24, 1);
    will-change: transform;
  }
  .intro-left { left: 0; }
  .intro-right { right: 0; }

  .intro-mark {
    position: absolute; top: 50%; width: 100vw; transform: translateY(-50%);
    display: flex; flex-direction: column; align-items: center; gap: clamp(18px, 2.4vw, 30px);
  }
  .intro-left .intro-mark { left: 0; }
  .intro-right .intro-mark { left: -100%; }

  /* Polished platinum. The diffraction spectrum is a narrow flare travelling through it, not a
     wash over it — the difference between jewellery and a rainbow. */
  .intro-mr {
    position: relative;
    font: 300 clamp(5rem, 24vw, 16rem)/1 var(--serif);
    letter-spacing: 0.06em;
    /* Polished platinum, lit from above. Every stop stays in the bright half of the ramp so the
       letters read as precious metal at rest; the spectrum is a narrow flare passing through. */
    background: linear-gradient(
      100deg,
      #9d998c 0%, #ded9c9 9%, #fffdf6 17%, #ffffff 22%,
      #ded6ff 27%, #bce9ff 30%, #c4f6de 33%, #fbf1bd 36%, #ffdac6 39%,
      #ffffff 44%, #f6f2e7 52%, #d6d1c2 64%, #a9a598 80%, #85827a 100%
    );
    background-size: 230% 100%;
    background-position: 140% 0;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.38);
    filter:
      drop-shadow(0 0 46px rgba(190, 215, 255, 0.22))
      drop-shadow(0 1px 0 rgba(255, 255, 255, 0.28))
      drop-shadow(0 3px 3px rgba(0, 0, 0, 0.75));
    opacity: 0; transform: scale(0.97);
    transition: opacity 700ms var(--ease), transform 1200ms var(--ease);
  }
  /* Bevel: the top facets catch the light, the way a cut edge does. */
  .intro-mr::before {
    content: attr(data-text);
    position: absolute; left: 0; top: 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.34) 24%, rgba(255, 255, 255, 0) 48%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    mix-blend-mode: screen; pointer-events: none;
  }
  /* A hard, narrow specular band riding the same edges. */
  .intro-mr::after {
    content: attr(data-text);
    position: absolute; left: 0; top: 0;
    background: linear-gradient(101deg, transparent 44%, rgba(255, 255, 255, 1) 48.5%, rgba(226, 244, 255, 0.75) 50.5%, transparent 55%);
    background-size: 300% 100%; background-position: 150% 0;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.14);
    mix-blend-mode: screen; pointer-events: none;
  }

  .intro-rule { width: 0; height: 1px; background: var(--spectrum); opacity: 0; transition: width 900ms var(--ease), opacity 600ms; }

  .intro-name {
    font: 400 clamp(10px, 1.1vw, 13px)/1 var(--sans);
    letter-spacing: 0.46em; text-transform: uppercase; color: #a5a39b;
    opacity: 0; transform: translateY(6px);
    transition: opacity 700ms var(--ease) 100ms, transform 700ms var(--ease) 100ms;
    padding-left: 0.46em; /* letter-spacing pads the right; keep the line optically centred */
  }

  .intro.in .intro-mr { opacity: 1; transform: scale(1); animation: mr-sheen 1.7s var(--ease) 60ms forwards; }
  .intro.in .intro-mr::after { animation: mr-flash 1.5s var(--ease) 200ms forwards; }
  .intro.in .intro-rule { width: clamp(90px, 12vw, 190px); opacity: 0.9; }
  .intro.in .intro-name { opacity: 1; transform: none; }

  @keyframes mr-sheen { to { background-position: -70% 0; } }
  @keyframes mr-flash { to { background-position: -180% 0; } }

  /* The parting light along the cut. */
  .intro-seam {
    position: absolute; left: 50%; top: -5%; bottom: -5%; width: 3px; margin-left: -1.5px; opacity: 0;
    background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.92) 32%, rgba(190, 225, 255, 0.98) 50%, rgba(255, 255, 255, 0.92) 68%, transparent);
    filter: drop-shadow(0 0 18px rgba(170, 215, 255, 0.9)) drop-shadow(0 0 44px rgba(120, 180, 255, 0.5));
  }

  .intro.open .intro-left { transform: translate3d(-101%, 0, 0); }
  .intro.open .intro-right { transform: translate3d(101%, 0, 0); }
  .intro.open .intro-mark { opacity: 0.92; transform: translateY(-50%) scale(1.04); transition: opacity 620ms var(--ease), transform 820ms var(--ease); }
  .intro.open .intro-seam { animation: seam-flare 640ms var(--ease) forwards; }
  @keyframes seam-flare {
    0% { opacity: 0; transform: scaleY(0.7); }
    20% { opacity: 1; transform: scaleY(1); }
    100% { opacity: 0; transform: scaleY(1.04); }
  }

  /* The site settles forward as the doors clear. */
  :global(html.intro-revealing main) { animation: intro-settle 820ms var(--ease) both; }
  @keyframes intro-settle {
    from { opacity: 0.55; transform: scale(1.02); }
    to { opacity: 1; transform: none; }
  }
  :global(html.intro-lock) { overflow: hidden; }

  @media (prefers-reduced-motion: reduce) { .intro { display: none; } }
</style>

<!-- Inline and un-bundled so it runs during parse: the skip handlers are live almost immediately,
     and the curtain is never held up waiting for a module to download. -->
<script is:inline>
  (function () {
    var intro = document.querySelector('.intro');
    var root = document.documentElement;
    if (!intro) return;
    // Belt and braces: never lock the page, even if the pre-paint check in Base.astro was missed.
    var seen = false;
    try { seen = sessionStorage.getItem('mr-intro') === '1'; } catch (e) {}
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (root.classList.contains('intro-skip') || seen || reduce) { intro.remove(); return; }

    try { sessionStorage.setItem('mr-intro', '1'); } catch (e) { /* private mode: play it, don't remember */ }
    root.classList.add('intro-lock');

    var finished = false;
    function finish() {
      if (finished) return;
      finished = true;
      root.classList.remove('intro-lock', 'intro-revealing');
      root.dataset.intro = 'done';
      intro.remove();
    }
    function open() {
      if (intro.classList.contains('open')) return;
      intro.classList.add('in', 'open');
      root.classList.add('intro-revealing');
      setTimeout(finish, 860);
    }

    // Hold the monogram only briefly for its typeface, so it never flashes in a fallback face.
    var start = function () {
      requestAnimationFrame(function () { intro.classList.add('in'); });
      setTimeout(open, 1000);
    };
    if (document.fonts && document.fonts.ready) {
      var started = false;
      var once = function () { if (!started) { started = true; start(); } };
      document.fonts.ready.then(once);
      setTimeout(once, 450);
    } else {
      start();
    }

    // Any intent to get on with it opens the doors at once.
    ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach(function (e) {
      addEventListener(e, open, { once: true, passive: true });
    });
    // Whatever happens above, the curtain never stays down.
    setTimeout(finish, 5000);
  })();
</script>
